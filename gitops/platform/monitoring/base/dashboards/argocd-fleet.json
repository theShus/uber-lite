{
  "uid": "argocd-fleet",
  "title": "Uber-lite / Argo CD fleet",
  "description": "Health and sync of every Application Argo CD manages, its syncs and its controller (19.4).",
  "tags": ["uber-lite", "argocd"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {"list": [
    {"type": "datasource", "name": "datasource", "label": "Data source", "query": "prometheus", "current": {}, "hide": 0, "refresh": 1, "regex": "", "options": []}
  ]},
  "annotations": {"list": [
    {"name": "Deploys", "enable": true, "iconColor": "#8AB8FF", "datasource": {"type": "datasource", "uid": "grafana"}, "target": {"type": "tags", "tags": ["deploy"], "matchAny": true, "limit": 100}}
  ]},
  "panels": [
    {"type": "row", "title": "Every Application this Argo CD manages, on every cluster", "id": 1, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {"type": "bargauge", "title": "Applications by health", "id": 2, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (health_status) (argocd_app_info)", "legendFormat": "{{health_status}}", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"type": "bargauge", "title": "Applications by sync status", "id": 3, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (sync_status) (argocd_app_info)", "legendFormat": "{{sync_status}}", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"type": "stat", "title": "Clusters Argo CD can't reach", "id": 4, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "count(argocd_cluster_connection_status == 0) or vector(0)", "legendFormat": "unreachable", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}},
    {"type": "table", "title": "Applications that need attention (not Healthy, or not Synced)", "id": 5, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 9}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "argocd_app_info{health_status!=\"Healthy\"} or argocd_app_info{sync_status!=\"Synced\"}", "legendFormat": "", "instant": true, "range": false, "format": "table", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "container": true, "endpoint": true, "instance": true, "job": true, "pod": true, "service": true, "team": true, "autosync_enabled": true, "operation": true}, "renameByName": {"name": "Application", "health_status": "Health", "sync_status": "Sync"}}}]},
    {"type": "row", "title": "Syncs and the controller", "id": 6, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "panels": []},
    {"type": "timeseries", "title": "Sync operations per 5 minutes, by phase", "id": 7, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}, "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 1, "fillOpacity": 10}}, "overrides": []}, "targets": [{"expr": "sum by (phase) (increase(argocd_app_sync_total[5m]))", "legendFormat": "{{phase}}", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Reconcile time p95", "id": 8, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}, "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "fillOpacity": 10}}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(argocd_app_reconcile_bucket[$__rate_interval])))", "legendFormat": "p95", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Applications per ApplicationSet", "id": 9, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26}, "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 1, "fillOpacity": 10}}, "overrides": []}, "targets": [{"expr": "argocd_appset_owned_applications", "legendFormat": "{{name}}", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Cluster connection status", "id": 10, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26}, "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 1, "fillOpacity": 10}}, "overrides": []}, "targets": [{"expr": "argocd_cluster_connection_status", "legendFormat": "{{server}}", "range": true, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "refId": "A"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}}
  ]
}
